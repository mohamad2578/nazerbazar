# ─── الزامی ───
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DB_PASSWORD=change-me
DEBUG=0
ALLOWED_HOSTS=nazer724.ir,www.nazer724.ir
CSRF_TRUSTED_ORIGINS=https://nazer724.ir,https://www.nazer724.ir
HTTP_PORT=8080

# ─── پیامک ───
# SMS_BACKEND یکی از: console (فقط لاگ) | ghasedak | kavenegar
SMS_BACKEND=ghasedak
GHASEDAK_API_KEY=
# شماره خط ارسال؛ فقط برای ارسال متن آزاد (وقتی قالب تعریف نشده) لازم است
GHASEDAK_LINE=
# نام قالب‌های تاییدشده در پنل قاصدک (اختیاری، ولی پیشنهاد می‌شود)
GHASEDAK_PRICE_TEMPLATE=
GHASEDAK_OTP_TEMPLATE=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
OTP_ECHO=0

# ─── درگاه پرداخت اینترنتی ───
# بدون درگاه واقعی، پرداخت اینترنتی روی سرور واقعی بسته می‌ماند (شبیه‌ساز فقط در توسعه کار می‌کند).
PAYMENT_BACKEND=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# ─── قواعد بازار ───
MARKET_DEFAULT_MAX_DISCOUNT=20
MARKET_UPDATE_GRACE_HOURS=24
MARKET_ALERT_CHANGE_PERCENT=10
